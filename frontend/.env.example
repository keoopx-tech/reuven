# Copiar como .env.local para desarrollo.
#
# En producción (Vercel) esta variable NO va en un archivo — se configura en:
# Vercel Dashboard → Project → Settings → Environment Variables
# con la URL pública de tu backend en Render, ej:
# VITE_API_URL=https://reuven-api.onrender.com
VITE_API_URL=http://localhost:8000
