# Copiar como .env y rellenar los valores reales.
#
# ── Desarrollo local (SQLite, sin instalar Postgres) ──────────────────────
# DATABASE_URL=sqlite+aiosqlite:///./reuven.db
#
# ── Producción (Neon / Supabase / Render Postgres) ────────────────────────
# Pega el connection string que te da el proveedor, con el prefijo
# "postgresql+asyncpg://" (no "postgresql://" a secas — ese es para psycopg2).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/reuven

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# En producción esto va como env var en Render, NUNCA committeado.
JWT_SECRET=cambia-esto-en-produccion-minimo-32-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Dominios permitidos a llamar la API. En producción, el dominio de Vercel:
# CORS_ORIGINS=["https://reuven.vercel.app"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# "production" desactiva /docs y /redoc (Swagger) — ver app/config.py
ENVIRONMENT=development
BCRYPT_ROUNDS=12
